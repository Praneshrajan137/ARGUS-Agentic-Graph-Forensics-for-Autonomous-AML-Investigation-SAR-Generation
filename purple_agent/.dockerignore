# ═══════════════════════════════════════════════════════════════════
# Purple Agent — Docker Build Context Exclusions
# ═══════════════════════════════════════════════════════════════════

# Version control
.git
.gitignore

# Tests (not needed in production image)
tests/

# Scripts (preflight runs outside container)
# NOTE: ralph.sh is NOT excluded — it's the entrypoint
scripts/

# Environment files (secrets — pass via --env-file at runtime)
.env
.env.*

# Documentation (not needed at runtime)
*.md

# Python artifacts
__pycache__/
*.pyc
*.pyo
*.egg-info/

# Test and coverage artifacts
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# IDE artifacts
.vscode/
.idea/
*.swp
*.swo

# Docker-in-docker prevention
Dockerfile
Dockerfile.*
docker-compose*.yml
